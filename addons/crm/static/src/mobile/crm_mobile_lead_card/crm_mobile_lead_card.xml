<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!--
        Render the projected card unless a pending, non-parked delete/archive hides it;
        provisional actions need a server ID.
    -->
    <t t-name="crm.CrmMobileLeadCard">
        <t t-set="card" t-value="this.cardData"/>
        <div t-if="card"
            class="o_crm_mobile_lead_card d-flex flex-column gap-2 p-2 border rounded bg-view"
            t-att-class="{ 'o_crm_mobile_lead_card_provisional': this.isProvisional }">
            <button type="button"
                class="o_crm_mobile_lead_open btn btn-link text-start text-reset p-0 d-flex flex-column align-items-start w-100"
                data-available-offline="1"
                t-att-disabled="this.isProvisional"
                t-on-click="this.onOpenClick">
                <span class="o_crm_mobile_lead_name fw-bold" t-out="card.values.name"/>
                <span t-if="card.partnerLabel" class="o_crm_mobile_lead_partner text-muted" t-out="card.partnerLabel"/>
                <span t-if="card.revenueLabel" class="o_crm_mobile_lead_revenue" t-out="card.revenueLabel"/>
            </button>
            <span t-if="card.syncState"
                class="o_crm_mobile_pending_sync badge align-self-start"
                t-att-class="card.syncState === 'failed' ? 'text-bg-danger' : 'text-bg-warning'"
                aria-hidden="true">
                <t t-if="card.syncState === 'failed'">Sync failed</t><t t-else="">Pending sync</t>
            </span>
            <!-- Always present so its text change is announced; the visible badge is hidden from assistive technology to avoid reading it twice. -->
            <span class="o_crm_mobile_lead_sync_status visually-hidden" role="status">
                <t t-if="card.syncState === 'failed'">Sync failed</t><t t-elif="card.syncState">Pending sync</t>
            </span>
            <div class="o_crm_mobile_lead_actions d-flex gap-2 align-items-center">
                <!-- No selector without a loaded stage or choices; a stage outside the choices shows as an unselectable current option. -->
                <select t-if="card.stage"
                    class="o_crm_mobile_lead_stage form-select"
                    data-available-offline="1"
                    aria-label="Stage"
                    t-att-disabled="this.isProvisional"
                    t-on-change="this.onStageChange">
                    <option t-if="card.stage.missing" value="" selected="selected" disabled="disabled" t-out="card.stage.label"/>
                    <t t-foreach="this.props.stages" t-as="stage" t-key="stage.id">
                        <option t-att-value="stage.id"
                            t-att-selected="stage.id === card.stage.id"
                            t-out="stage.display_name"/>
                    </t>
                </select>
                <!-- Scheduling needs the lead's server id: no sheet for a provisional card. -->
                <button type="button"
                    class="o_crm_mobile_lead_activities_button btn btn-secondary"
                    data-available-offline="1"
                    title="Activities"
                    aria-label="Activities"
                    t-att-disabled="this.isProvisional"
                    t-on-click="this.openActivities">
                    <i class="fa fa-clock-o" aria-hidden="true"/>
                </button>
            </div>
        </div>
    </t>

    <!-- Use a div for the draft: Enter must not schedule an activity; only Save does. -->
    <t t-name="crm.CrmMobileLeadActivities">
        <div class="o_crm_mobile_lead_activities_sheet d-flex flex-column gap-3 p-3">
            <header class="d-flex flex-column">
                <h4 class="mb-0">Activities</h4>
                <span t-if="this.leadRecord" class="text-muted" t-out="this.leadRecord.data.name"/>
            </header>

            <ul class="o_crm_mobile_lead_activities list-unstyled d-flex flex-column gap-2 mb-0" aria-live="polite">
                <li t-foreach="this.syncedRows" t-as="row" t-key="row.id"
                    class="o_crm_mobile_activity_row d-flex align-items-center gap-2"
                    t-att-class="{ 'o_crm_mobile_activity_done_pending': row.donePending }"
                    t-att-data-activity-id="row.id">
                    <div class="o_crm_mobile_activity_info d-flex flex-column flex-grow-1 min-w-0">
                        <span class="o_crm_mobile_activity_title fw-bold text-truncate" t-out="row.summary or row.typeLabel"/>
                        <span class="o_crm_mobile_activity_details d-flex flex-wrap column-gap-2 text-muted small">
                            <span t-if="row.typeLabel" class="o_crm_mobile_activity_type_label" t-out="row.typeLabel"/>
                            <span t-if="row.deadlineLabel" class="o_crm_mobile_activity_deadline" t-out="row.deadlineLabel"/>
                            <span t-if="row.assigneeLabel" class="o_crm_mobile_activity_assignee" t-out="row.assigneeLabel"/>
                        </span>
                    </div>
                    <button type="button"
                        class="o_crm_mobile_activity_done btn btn-secondary ms-auto"
                        data-available-offline="1"
                        t-att-disabled="row.donePending or row.doneBusy"
                        t-att-aria-busy="row.doneBusy ? 'true' : false"
                        t-on-click="() => this.markDone(row)">
                        <t t-if="row.donePending">Done · Pending sync</t><t t-else="">Mark done</t>
                    </button>
                </li>
                <li t-foreach="this.pendingRows" t-as="row" t-key="row.key"
                    class="o_crm_mobile_activity_row o_crm_mobile_activity_pending d-flex align-items-center gap-2">
                    <div class="o_crm_mobile_activity_info d-flex flex-column flex-grow-1 min-w-0">
                        <span class="o_crm_mobile_activity_title fw-bold text-truncate" t-out="row.summary or row.typeLabel"/>
                        <span class="o_crm_mobile_activity_details d-flex flex-wrap column-gap-2 text-muted small">
                            <span t-if="row.typeLabel" class="o_crm_mobile_activity_type_label" t-out="row.typeLabel"/>
                            <span t-if="row.deadlineLabel" class="o_crm_mobile_activity_deadline" t-out="row.deadlineLabel"/>
                        </span>
                    </div>
                    <!-- A queued create has no server id yet, hence no "Mark done". -->
                    <span class="o_crm_mobile_pending_sync badge"
                        t-att-class="row.parked ? 'text-bg-danger' : 'text-bg-warning'">
                        <t t-if="row.parked">Sync failed</t><t t-else="">Pending sync</t>
                    </span>
                </li>
            </ul>

            <!-- Additional mobile pages require an online root reload; otherwise show only the remaining count. -->
            <div t-if="this.canLoadMoreActivities"
                class="o_crm_mobile_activities_more_online d-flex align-items-center gap-2">
                <span class="o_crm_mobile_activities_more_count text-muted"><t t-out="this.moreCount"/> more activities</span>
                <button type="button"
                    class="o_crm_mobile_activities_load_more btn btn-secondary ms-auto"
                    t-att-disabled="this.isLoadingMoreActivities"
                    t-on-click="this.loadMoreActivities">Show more</button>
            </div>
            <p t-elif="this.moreCount" class="o_crm_mobile_activities_more text-muted mb-0" role="status"><t t-out="this.moreCount"/> more activities after sync</p>
            <!-- No activity data cached for this lead: scheduling stays available. -->
            <p t-if="this.hasNoActivityData" class="o_crm_mobile_activities_notice text-muted mb-0" role="status">Activities load after sync</p>

            <div t-if="!this.state.form" class="o_crm_mobile_activity_actions d-flex gap-2">
                <button type="button"
                    class="o_crm_mobile_log_call btn btn-primary"
                    data-available-offline="1"
                    t-att-disabled="!this.canLogCall"
                    t-on-click="this.openLogCall">Log a call</button>
                <button type="button"
                    class="o_crm_mobile_schedule_followup btn btn-secondary"
                    data-available-offline="1"
                    t-att-disabled="!this.hasTypes"
                    t-on-click="this.openFollowUp">Schedule follow-up</button>
            </div>
            <!-- The openers require cached types; an open form keeps its type options until it closes, and Save revalidates against the options shown. -->
            <div t-else="" class="o_crm_mobile_activity_form d-flex flex-column gap-2">
                <select class="o_crm_mobile_activity_type form-select"
                    t-att-class="{ 'is-invalid o_field_invalid': this.state.invalid.activity_type_id }"
                    data-available-offline="1"
                    aria-label="Activity type"
                    required=""
                    t-ref="this.typeRef"
                    t-att-aria-invalid="this.state.invalid.activity_type_id ? 'true' : false"
                    t-att-aria-describedby="this.state.invalid.activity_type_id ? this.fieldId('activity_type_id_feedback') : false"
                    t-on-change="(ev) => this.onFormChange('activity_type_id', ev)">
                    <option t-foreach="this.state.types" t-as="type" t-key="type.id"
                        t-att-value="type.id"
                        t-att-selected="type.id == this.state.form.activity_type_id"
                        t-out="type.display_name"/>
                </select>
                <div t-if="this.state.invalid.activity_type_id"
                    class="invalid-feedback d-block"
                    t-att-id="this.fieldId('activity_type_id_feedback')">An activity type is required.</div>
                <input type="text"
                    class="o_crm_mobile_activity_summary form-control"
                    data-available-offline="1"
                    placeholder="Summary"
                    aria-label="Summary"
                    t-att-value="this.state.form.summary"
                    t-on-input="(ev) => this.onFormChange('summary', ev)"/>
                <input type="date"
                    class="o_crm_mobile_activity_date form-control"
                    t-att-class="{ 'is-invalid o_field_invalid': this.state.invalid.date_deadline }"
                    data-available-offline="1"
                    aria-label="Due date"
                    required=""
                    t-ref="this.dateRef"
                    t-att-aria-invalid="this.state.invalid.date_deadline ? 'true' : false"
                    t-att-aria-describedby="this.state.invalid.date_deadline ? this.fieldId('date_deadline_feedback') : false"
                    t-att-value="this.state.form.date_deadline"
                    t-on-change="(ev) => this.onFormChange('date_deadline', ev)"/>
                <div t-if="this.state.invalid.date_deadline"
                    class="invalid-feedback d-block"
                    t-att-id="this.fieldId('date_deadline_feedback')">A valid due date is required.</div>
                <select class="o_crm_mobile_activity_user form-select"
                    t-att-class="{ 'is-invalid o_field_invalid': this.state.invalid.user_id }"
                    data-available-offline="1"
                    aria-label="Assigned to"
                    required=""
                    t-ref="this.userRef"
                    t-att-aria-invalid="this.state.invalid.user_id ? 'true' : false"
                    t-att-aria-describedby="this.state.invalid.user_id ? this.fieldId('user_id_feedback') : false"
                    t-on-change="(ev) => this.onFormChange('user_id', ev)">
                    <option t-foreach="this.state.assignees" t-as="assignee" t-key="assignee.id"
                        t-att-value="assignee.id"
                        t-att-selected="assignee.id == this.state.form.user_id"
                        t-out="assignee.display_name"/>
                </select>
                <div t-if="this.state.invalid.user_id"
                    class="invalid-feedback d-block"
                    t-att-id="this.fieldId('user_id_feedback')">An assignee is required.</div>
                <div class="d-flex gap-2">
                    <button type="button"
                        class="o_crm_mobile_activity_save btn btn-primary"
                        data-available-offline="1"
                        t-att-disabled="this.state.saving"
                        t-on-click="this.saveForm">Save</button>
                    <button type="button"
                        class="o_crm_mobile_activity_cancel btn btn-secondary"
                        data-available-offline="1"
                        t-att-disabled="this.state.saving"
                        t-on-click="this.cancelForm">Cancel</button>
                </div>
            </div>
        </div>
    </t>

    <!-- Primary inheritance preserves framework extensions without adding a desktop activities button. -->
    <t t-name="crm.CrmFormView" t-inherit="web.FormView" t-inherit-mode="primary">
        <xpath expr="//Layout/t[@t-set-slot='control-panel-additional-actions']" position="inside">
            <button t-if="this.crmOffline.isSmall and this.model.root.resId and !this.env.inDialog"
                type="button"
                class="btn btn-secondary o_crm_mobile_activities_button"
                data-available-offline="1"
                t-on-click="this.openMobileActivities">Activities</button>
        </xpath>
    </t>

</templates>
