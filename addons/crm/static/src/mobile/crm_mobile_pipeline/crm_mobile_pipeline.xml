<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!--
        Wide screens and other groupings reuse framework rendering. Synced-card `resId`
        keys preserve open sheets across record replacement.
    -->
    <t t-name="crm.CrmMobilePipeline">
        <t t-if="!this.isMobile" t-call="web.KanbanRenderer"/>
        <t t-elif="this.props.list.isGrouped and !(this.isStagePipeline and this.activeGroup)" t-call="web.KanbanRenderer"/>
        <div t-else=""
            class="o_kanban_renderer o_renderer o_crm_mobile_pipeline"
            t-att-class="{ o_crm_mobile_pipeline_ungrouped: !this.props.list.isGrouped }"
            t-ref="this.rootRef">
            <t t-set="stageChoices" t-value="this.stages"/>
            <t t-if="this.isStagePipeline">
                <t t-set="group" t-value="this.activeGroup"/>
                <t t-if="group">
                    <t t-set="stageView" t-value="this.crmStageView(group)"/>
                    <div class="o_crm_mobile_pipeline_header">
                        <!-- Navigation reads the clamped index: a stale `mobile.activeIndex` past the last stage never blocks it. -->
                        <button type="button"
                            class="btn btn-light o_crm_mobile_pipeline_prev"
                            data-available-offline="1"
                            t-att-disabled="!this.hasPreviousStage"
                            aria-label="Previous stage"
                            title="Previous stage"
                            t-on-click="() => this.goToStage(this.activeIndex - 1)">
                            <i class="oi oi-chevron-left" aria-hidden="true"/>
                        </button>
                        <div class="o_crm_mobile_pipeline_stage">
                            <!-- A heading by role, so heading navigation reaches the displayed stage; a <h2> would bring Bootstrap's heading size and margin. -->
                            <div class="o_crm_mobile_pipeline_stage_name fw-bold" role="heading" aria-level="2" aria-live="polite" t-out="group.displayName"/>
                            <div class="o_crm_mobile_pipeline_summary">
                                <span class="o_crm_mobile_pipeline_count" t-out="stageView.count"/>
                                <!-- Omit revenue for a filtered count or a root without the revenue aggregate; empty stages use zero. -->
                                <t t-set="revenue" t-value="stageView.revenue"/>
                                <span t-if="revenue" class="o_crm_mobile_pipeline_revenue">
                                    <AnimatedNumber value="revenue.value" duration="1000" currencies="revenue.currencies"/>
                                </span>
                            </div>
                            <!-- Reads out the final count and revenue when queued writes, a replay or a stage change update them; the animated number itself stays out of any live region. -->
                            <span class="visually-hidden o_crm_mobile_pipeline_status" role="status" aria-atomic="true" t-out="this.crmStageStatus(stageView)"/>
                        </div>
                        <button type="button"
                            class="btn btn-light o_crm_mobile_pipeline_next"
                            data-available-offline="1"
                            t-att-disabled="!this.hasNextStage"
                            aria-label="Next stage"
                            title="Next stage"
                            t-on-click="() => this.goToStage(this.activeIndex + 1)">
                            <i class="oi oi-chevron-right" aria-hidden="true"/>
                        </button>
                        <!-- The quick create needs no cached onchange: usable offline in every loaded stage. -->
                        <button type="button"
                            class="btn btn-primary o_crm_mobile_pipeline_new"
                            data-available-offline="1"
                            t-att-disabled="!this.canQuickCreate()"
                            t-on-click="(ev) => this.openQuickCreate(ev.currentTarget)">New</button>
                    </div>
                    <div class="o_crm_mobile_pipeline_body"
                        t-on-touchstart="this.onTouchStart"
                        t-on-touchend="this.onTouchEnd">
                        <!-- A lead whose form was never visited online cannot open offline. "Back" takes the focus, described by the helper's text. -->
                        <t t-if="this.mobile.helperLeadId">
                            <button type="button"
                                class="btn btn-link o_crm_mobile_pipeline_helper_back"
                                data-available-offline="1"
                                t-att-aria-describedby="this.crmLeadHelperId"
                                t-ref="this.crmHelperBackRef"
                                t-on-click="() => this.closeLeadHelper()"><i class="oi oi-arrow-left me-1" aria-hidden="true"/>Back</button>
                            <!-- Generates no box: the helper is laid out in the body as the stage helper is. -->
                            <div class="o_crm_mobile_pipeline_lead_helper d-contents" t-att-id="this.crmLeadHelperId">
                                <OfflineActionHelper/>
                            </div>
                        </t>
                        <OfflineActionHelper t-elif="this.isStageUnavailableOffline(group)"/>
                        <t t-else="">
                            <!-- The card calls onOpen(record) and onMoveStage(record, stageId). -->
                            <t t-foreach="stageView.records" t-as="record" t-key="record.resId">
                                <CrmMobileLeadCard
                                    record="record"
                                    stages="stageChoices"
                                    archInfo="this.props.archInfo"
                                    getRecord.bind="this.getRecord"
                                    onOpen.bind="this.openLead"
                                    onMoveStage.bind="this.moveLead"/>
                            </t>
                            <!-- Leads created offline: the card itself never opens or moves a provisional card. -->
                            <t t-foreach="stageView.pending" t-as="pending" t-key="pending.key">
                                <CrmMobileLeadCard
                                    provisional="pending"
                                    stages="stageChoices"
                                    archInfo="this.props.archInfo"
                                    getRecord.bind="this.getRecord"
                                    onOpen.bind="this.openLead"
                                    onMoveStage.bind="this.moveLead"/>
                            </t>
                            <!-- A filtered count of 0 leaves nothing to load, as the header shows. -->
                            <t t-set="unloadedCount" t-value="this.crmGetUnloadedCount(group)"/>
                            <div t-if="this.showLoadMore(unloadedCount)" class="o_crm_mobile_pipeline_load_more">
                                <!-- Disabled and busy while its load runs: a repeat click starts no other load. -->
                                <t t-set="loadingMore" t-value="this.crmLoadingMore.has(group.id)"/>
                                <button type="button"
                                    class="btn btn-outline-primary w-100"
                                    t-att-disabled="loadingMore"
                                    t-att-aria-busy="loadingMore ? 'true' : false"
                                    t-on-click="() => this.crmLoadMore(group)"><i t-if="loadingMore" class="fa fa-circle-o-notch fa-spin me-1" aria-hidden="true"/>Load more... (<t t-out="unloadedCount"/> remaining)</button>
                            </div>
                        </t>
                    </div>
                </t>
            </t>
            <t t-else="">
                <div class="o_crm_mobile_pipeline_body">
                    <t t-if="this.mobile.helperLeadId">
                        <button type="button"
                            class="btn btn-link o_crm_mobile_pipeline_helper_back"
                            data-available-offline="1"
                            t-att-aria-describedby="this.crmLeadHelperId"
                            t-ref="this.crmHelperBackRef"
                            t-on-click="() => this.closeLeadHelper()"><i class="oi oi-arrow-left me-1" aria-hidden="true"/>Back</button>
                        <div class="o_crm_mobile_pipeline_lead_helper d-contents" t-att-id="this.crmLeadHelperId">
                            <OfflineActionHelper/>
                        </div>
                    </t>
                    <t t-else="">
                        <t t-foreach="this.getUngroupedRecords()" t-as="record" t-key="record.resId">
                            <CrmMobileLeadCard
                                record="record"
                                stages="stageChoices"
                                archInfo="this.props.archInfo"
                                getRecord.bind="this.getRecord"
                                onOpen.bind="this.openLead"
                                onMoveStage.bind="this.moveLead"/>
                        </t>
                    </t>
                </div>
            </t>
            <ActionHelper t-if="this.showNoContentHelper" noContentHelp="this.props.noContentHelp"/>
        </div>
    </t>

    <!--
        Mail retargets only the after dropdown; before/all-stages need the plain
        variant. Both variants mark stage choices available offline.
    -->
    <t t-name="crm.StatusBarDurationField.Dropdown" t-inherit="mail.StatusBarDurationField.Dropdown" t-inherit-mode="primary">
        <xpath expr="//DropdownItem" position="attributes">
            <attribute name="attrs">{'data-available-offline': '1'}</attribute>
        </xpath>
    </t>

    <t t-name="crm.StatusBarField.Dropdown" t-inherit="web.StatusBarField.Dropdown" t-inherit-mode="primary">
        <xpath expr="//DropdownItem" position="attributes">
            <attribute name="attrs">{'data-available-offline': '1'}</attribute>
        </xpath>
    </t>

    <t t-name="crm.RottingStatusBarDurationField" t-inherit="mail.RottingStatusBarDurationField" t-inherit-mode="primary">
        <xpath expr="//button[@t-ref='this.afterRef']" position="attributes">
            <attribute name="data-available-offline">1</attribute>
        </xpath>
        <xpath expr="//button[@role='radio']" position="attributes">
            <attribute name="data-available-offline">1</attribute>
        </xpath>
        <xpath expr="//button[@t-ref='this.beforeRef']" position="attributes">
            <attribute name="data-available-offline">1</attribute>
        </xpath>
        <xpath expr="//button[@t-ref='this.dropdownRef']" position="attributes">
            <attribute name="data-available-offline">1</attribute>
        </xpath>
        <xpath expr="//t[@t-call='mail.StatusBarDurationField.Dropdown']" position="attributes">
            <attribute name="t-call">crm.StatusBarDurationField.Dropdown</attribute>
        </xpath>
        <xpath expr="//Dropdown[button[@t-ref='this.beforeRef']]//t[@t-call='web.StatusBarField.Dropdown']" position="attributes">
            <attribute name="t-call">crm.StatusBarField.Dropdown</attribute>
        </xpath>
        <xpath expr="//Dropdown[button[@t-ref='this.dropdownRef']]//t[@t-call='web.StatusBarField.Dropdown']" position="attributes">
            <attribute name="t-call">crm.StatusBarField.Dropdown</attribute>
        </xpath>
    </t>

    <!--
        Module installation confirmation of the lead generation dropdown
        (CrmInstallConfirmationDialog). Same DOM as web.ConfirmationDialog except that
        Confirm loses data-available-offline (an empty attribute removes it), so the
        framework disables it offline: installing needs the server. Cancel keeps it.
    -->
    <t t-name="crm.InstallConfirmationDialog" t-inherit="web.ConfirmationDialog" t-inherit-mode="primary">
        <xpath expr="//button[@t-on-click='this._confirm']" position="attributes">
            <attribute name="data-available-offline"/>
        </xpath>
    </t>

    <!--
        CRM availability attributes remain present online; offline-only disabled states
        restore the original values online. Repeated inheritance targets need separate
        xpaths.
    -->

    <!-- The CRM activity-menu row and its Late/Today/Future counters are not buttons: disabled while offline (isCrmGroupOffline, activity_menu_patch.js). -->
    <t t-inherit="mail.ActivityMenu" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o-mail-ActivityGroup')]" position="attributes">
            <attribute name="t-att-class">this.isCrmGroupOffline(group) ? 'o_disabled_offline pe-none' : ''</attribute>
            <attribute name="t-att-aria-disabled">this.isCrmGroupOffline(group) ? 'true' : false</attribute>
            <attribute name="t-att-tabindex">this.isCrmGroupOffline(group) ? '-1' : false</attribute>
        </xpath>
        <xpath expr="//div[@t-if=&quot;group.type === 'activity'&quot;]/span[1]" position="attributes">
            <attribute name="t-att-class">this.isCrmGroupOffline(group) ? 'o_disabled_offline pe-none' : ''</attribute>
            <attribute name="t-att-aria-disabled">this.isCrmGroupOffline(group) ? 'true' : false</attribute>
            <attribute name="t-att-tabindex">this.isCrmGroupOffline(group) ? '-1' : false</attribute>
        </xpath>
        <xpath expr="//div[@t-if=&quot;group.type === 'activity'&quot;]/span[2]" position="attributes">
            <attribute name="t-att-class">this.isCrmGroupOffline(group) ? 'o_disabled_offline pe-none' : ''</attribute>
            <attribute name="t-att-aria-disabled">this.isCrmGroupOffline(group) ? 'true' : false</attribute>
            <attribute name="t-att-tabindex">this.isCrmGroupOffline(group) ? '-1' : false</attribute>
        </xpath>
        <!-- span[3] is the flex spacer. -->
        <xpath expr="//div[@t-if=&quot;group.type === 'activity'&quot;]/span[4]" position="attributes">
            <attribute name="t-att-class">this.isCrmGroupOffline(group) ? 'o_disabled_offline pe-none' : ''</attribute>
            <attribute name="t-att-aria-disabled">this.isCrmGroupOffline(group) ? 'true' : false</attribute>
            <attribute name="t-att-tabindex">this.isCrmGroupOffline(group) ? '-1' : false</attribute>
        </xpath>
    </t>

    <!-- Card-menu toggle of lead cards: every item of the menu is queued or available offline. -->
    <t t-inherit="web.KanbanMenu" t-inherit-mode="extension">
        <xpath expr="//button[@title='Dropdown menu']" position="attributes">
            <attribute name="t-att-data-available-offline">this.props.record.resModel === 'crm.lead' ? '1' : false</attribute>
        </xpath>
    </t>

    <!-- Colour buttons of lead and sales-team cards: their colour write is queued offline. -->
    <t t-inherit="web.KanbanColorPickerField" t-inherit-mode="extension">
        <xpath expr="//button[@role='menuitem']" position="attributes">
            <attribute name="t-att-data-available-offline">['crm.lead', 'crm.team'].includes(this.props.record.resModel) ? '1' : false</attribute>
        </xpath>
    </t>

    <!--
        Anchors ignore disabled; guarded CRM buttons (crmOfflineGuarded,
        crm_offline_hooks.js) leave the tab order. Otherwise preserve aria-disabled from
        the attributes spread and the original tabindex.
    -->
    <t t-inherit="web.views.ViewButton" t-inherit-mode="extension">
        <xpath expr="//t[@t-tag='this.props.tag']" position="attributes">
            <attribute name="t-att-aria-disabled">this.crmOfflineGuarded ? 'true' : (this.props.attrs['aria-disabled'] ?? false)</attribute>
            <attribute name="t-att-tabindex">this.crmOfflineGuarded ? -1 : this.props.tabindex</attribute>
        </xpath>
    </t>

    <!-- View-mount backstop (crmOfflineBlocked, crm_offline_hooks.js): a blocked CRM target shows the offline helper instead of its controller. -->
    <t t-inherit="web.View" t-inherit-mode="extension">
        <xpath expr="//WithSearch" position="attributes">
            <attribute name="t-if">!this.crmOfflineBlocked</attribute>
        </xpath>
        <xpath expr="//WithSearch" position="after">
            <OfflineActionHelper t-else=""/>
        </xpath>
    </t>

    <!--
        The backstop is outside WithSearch: Reset Filters has no search model and
        cannot unblock the target. Keep the button only where a search model exists.
    -->
    <t t-inherit="web.OfflineActionHelper" t-inherit-mode="extension">
        <xpath expr="//button[@t-on-click='this.onResetFilters']" position="attributes">
            <attribute name="t-if" add="this.env.searchModel" separator=" and "/>
        </xpath>
    </t>

    <!-- Offline lead fields use cached inline autocomplete; the phone dialog requires the server. -->
    <t t-inherit="web.Many2XAutocomplete" t-inherit-mode="extension">
        <xpath expr="//input[@t-on-click='this.onSearchMore']" position="attributes">
            <attribute name="t-if">this.uiService.isSmall and this.props.dropdown and !this.crmOfflineInlineSearch</attribute>
        </xpath>
    </t>

</templates>
